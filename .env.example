# Copy to .env next to run.command. Only needed for what you use.
# Classify mode only (not --export-only):
ANTHROPIC_API_KEY=
# S3 upload (--s3-bucket):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Hetzner upload (--hetzner) - or put these in operator.env:
SFTP_HOST=
SFTP_PORT=23
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_BASE_PATH=workspace
